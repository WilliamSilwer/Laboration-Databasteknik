@model IEnumerable<MusicManager.Models.Artist> 


@{
    ViewData["Title"] = "Artister";
}   

<h1>@ViewBag.Message</h1>

<p>Antal artister: @ViewData["ArtistCount"]</p>

<h2>Våra artister</h2>

<p>
    <a asp-controller="Music" asp-action="AddArtist">
        Lägg till en ny artist
    </a>
</p>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Namn</th>
            <th>Födelseår</th>
            <th>Land</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var artist in Model)
        {
            <tr>
                <td>@artist.Id</td>
                <td> <a asp-controller="Music" 
                        asp-action="Details" 
                        asp-route-id="@artist.Id">@artist.Name</a></td>
                <td>@artist.BirthYear</td>
                <td>@artist.Country</td>
            </tr>
        }
    </tbody>
</table>